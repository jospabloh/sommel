{
  // Equipo autorizado como terminal (modo terminal, docs/modo-terminal-diseno.md).
  // Las cuatro operaciones son solo de plataforma / servicio: ni el propio bar
  // lee la llave del pase; solo la función `terminals` y el guard la usan.
  "name": "TerminalDevice",
  "type": "object",
  "properties": {
    "tenant_id": { "type": "string", "description": "WineBar al que pertenece la terminal. Módulo 19, candado de LECTURA y ESCRITURA a nivel entidad: las cuatro operaciones son solo de plataforma (role admin). Solo la función terminals (service role) crea, lee y revoca terminales, y el guard las lee para validar cada llamada. Si se afloja la lectura, cualquier miembro del bar lee pass_key y firma pases a nombre de cualquier compañero; si se afloja la escritura, puede quitarse revoked_at o meterse a la lista de otra terminal. Una terminal que no deja entrar no se arregla tocando este candado." },
    "name": { "type": "string", "description": "Nombre que el admin le dio al equipo (Caja, Barra)" },
    "account_user_id": { "type": "string", "description": "User de Base44 de la terminal (app_role terminal)" },
    "account_email": { "type": "string", "description": "Correo sin buzón de la cuenta de la terminal" },
    "pass_key": { "type": "string", "description": "Llave HMAC (32 bytes en hex) con la que se firman los pases de esta terminal" },
    "allowed": { "type": "object", "description": "Quién puede usarla: {mode:'all'} o {mode:'people', user_ids:[...]}" },
    "activated_by_user_id": { "type": "string", "description": "Quién la activó" },
    "activated_by_name": { "type": "string", "description": "Nombre congelado de quien la activó" },
    "last_seen_at": { "type": ["string", "null"], "format": "date-time", "description": "Último uso registrado" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time", "description": "Revocada desde esta hora; deja de funcionar en la siguiente llamada" },
    "revoked_by_user_id": { "type": ["string", "null"], "description": "Quién la revocó" }
  },
  "required": ["tenant_id", "name", "account_user_id", "pass_key"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
