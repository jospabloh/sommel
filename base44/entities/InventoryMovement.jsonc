{
  // Movimiento de inventario (§2 del plan). El stock de InventoryItem se
  // recalcula a partir de estos renglones; nunca se edita a mano. `idempotency_key`
  // sigue la misma lección que StockFlow's syncCashSaleToPettyCash: un reintento
  // por red no debe duplicar el movimiento.
  "name": "InventoryMovement",
  "type": "object",
  "properties": {
    "tenant_id": { "type": "string", "description": "WineBar dueño de este movimiento" },
    "item_id": { "type": "string", "description": "InventoryItem afectado" },
    "type": {
      "type": "string",
      "enum": ["entrada", "venta", "merma", "conteo", "devolucion"],
      "description": "Tipo de movimiento"
    },
    "qty": { "type": "number", "description": "Cantidad del movimiento (signo según el tipo)" },
    "unit_cost": {
      "type": ["integer", "null"],
      "description": "Costo por unidad al momento del movimiento, en centavos MXN. Se entrega solo con Menú:ver_costos (D7). Módulo 19, candado de LECTURA (rls.read solo role admin); no gobierna la escritura, que ya es solo de plataforma a nivel entidad. Lo escribe solo el servidor (función inventory, asServiceRole) y lo lee solo el servidor. Si se quita el candado, cualquier miembro del bar lee el costo de cada movimiento sin Menú:ver_costos. Un costo que no aparece en pantalla no se arregla quitando este candado: se diagnostica en la función inventory.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } }
      }
    },
    "reason": { "type": "string", "description": "Motivo (merma, conteo, devolución...)" },
    "order_item_id": { "type": "string", "description": "OrderItem que originó este movimiento, si aplica" },
    "idempotency_key": { "type": "string", "description": "Llave para no duplicar el mismo movimiento en un reintento" },
    "created_by": { "type": "string", "description": "Email de quien registró el movimiento" }
  },
  "required": ["tenant_id", "item_id", "type"],
  "rls": {
    "read": {
      "$or": [
        { "data.tenant_id": "{{user.data.tenant_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
