{
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "WineBar this order belongs to"
    },
    "table_id": {
      "type": "string",
      "description": "Table id for table orders, null for bar sales"
    },
    "table_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "bar",
        "table"
      ],
      "default": "bar"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "paid",
        "cancelled"
      ],
      "default": "open"
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      }
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "type"
  ],
  "name": "Order",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}