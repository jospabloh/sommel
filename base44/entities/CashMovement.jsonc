{
  // Salida de efectivo de caja durante un turno (§2 del plan).
  "name": "CashMovement",
  "type": "object",
  "properties": {
    "tenant_id": { "type": "string", "description": "WineBar dueño de este movimiento" },
    "shift_id": { "type": "string", "description": "Turno en el que se registró" },
    "amount": { "type": "integer", "description": "Monto de la salida en centavos MXN, guardado NEGATIVO" },
    "reason": { "type": "string", "description": "Motivo del retiro" },
    "idempotency_key": { "type": "string", "description": "Llave generada en el cliente; el servidor no crea dos salidas con la misma" },
    "created_by": { "type": "string", "description": "Email de quien registró el retiro" }
  },
  "required": ["tenant_id", "shift_id", "amount"],
  "rls": {
    "read": {
      "$or": [
        { "data.tenant_id": "{{user.data.tenant_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
