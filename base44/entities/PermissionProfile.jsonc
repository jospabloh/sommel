{
  // Módulo 3 — permisos granulares por rol dentro de un bar. Igual que
  // StockFlow's PermissionProfile: create/update/delete van a role:admin (no
  // el $or tenant habitual), porque un `staff` no debe poder rescribir el
  // perfil que decide lo que un `staff` puede hacer — eso deshace el
  // re-chequeo server-side de `hasPermission()` en cada Safe function.
  // `upsertProfile` (acción de la función `permissions`) valida
  // app_role === 'bar_admin' antes de escribir con la identidad del llamador;
  // toda otra escritura va por asServiceRole, que ya evalúa como role:admin.
  "name": "PermissionProfile",
  "type": "object",
  "properties": {
    "tenant_id": { "type": "string", "description": "WineBar al que pertenece este perfil" },
    "role": { "type": "string", "enum": ["bar_admin", "staff"], "description": "Rol del bar al que aplica este perfil" },
    "overrides": {
      "type": "object",
      "additionalProperties": true,
      "description": "Overrides en formato 'Módulo:acción' => true/false sobre los defaults del rol"
    }
  },
  "required": ["tenant_id", "role"],
  "rls": {
    "read": {
      "$or": [
        { "data.tenant_id": "{{user.data.tenant_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
