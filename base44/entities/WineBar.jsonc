{
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the wine bar"
    },
    "address": {
      "type": "string",
      "description": "Physical address"
    },
    "rfc": {
      "type": "string",
      "description": "RFC del bar, para el ticket y facturación"
    },
    "ticket_header": {
      "type": "string",
      "description": "Encabezado impreso en el ticket (58mm)"
    },
    "ticket_footer": {
      "type": "string",
      "description": "Pie impreso en el ticket (58mm)"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "view_only",
        "suspended"
      ],
      "default": "trial",
      "description": "Módulo 19: solo lo escribe la plataforma (Mission Control / createWineBar como service role). Candado de ESCRITURA (rls.write solo role admin); no afecta a las lecturas. Lo escriben la plataforma (Mission Control por acaciaControl, license.set) y createWineBar como service role. Si se quita el candado, cualquier bar_admin del bar, que sí puede actualizar WineBar, reactiva su propio bar suspendido o se pone en active con una llamada cruda a Base44: el $or de update de la entidad por sí solo no distingue campos. Un bar que aparece bloqueado por error no se arregla quitando este candado: se corrige el estado desde Mission Control.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "trial_end_at": {
      "type": "string",
      "format": "date-time",
      "description": "Módulo 19: candado de ESCRITURA (rls.write solo role admin); no afecta a las lecturas. Lo escriben la plataforma (license.set de acaciaControl) y createWineBar, que calcula el fin de la prueba de 30 días. Si se quita el candado, un bar en trial se estira su propia fecha de fin de prueba indefinidamente. Una prueba que venció antes de tiempo no se arregla quitando este candado: se corrige la fecha desde Mission Control.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "Módulo 19: candado de ESCRITURA (rls.write solo role admin); no afecta a las lecturas. Lo escribe solo la plataforma (license.set de acaciaControl, tras confirmar un pago en Mission Control). Si se quita el candado, un bar activo se extiende su propio periodo pagado sin pagar. Un periodo que aparece vencido por error no se arregla quitando este candado: se corrige desde Mission Control.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "plan": {
      "type": "string",
      "description": "Módulo 19: candado de ESCRITURA (rls.write solo role admin); no afecta a las lecturas. Lo escribe solo la plataforma (license.set de acaciaControl) y createWineBar al crear el bar. Si se quita el candado, un bar se sube de plan, y de límites, sin que la plataforma lo autorice. Un límite de plan que estorba no se arregla quitando este candado: se cambia el plan desde Mission Control.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "owner_id": {
      "type": "string",
      "description": "User id del dueño del bar. Módulo 19, candado de ESCRITURA (rls.write solo role admin); no afecta a las lecturas. Lo escribe solo createWineBar (service role) al crear el bar, y lo lee manageStaff para proteger al dueño (owner_locked: no se le degrada ni se le quita). Si se quita el candado, cualquier bar_admin del bar, que sí puede actualizar WineBar, se pone a sí mismo como dueño y anula la protección owner_locked. Un dueño que no aparece en pantalla no se arregla quitando este candado.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "Cuándo el dueño dio de baja el bar (account.deleteBar). Módulo 19, candado de ESCRITURA (rls.write solo role admin); no afecta a las lecturas. Lo escribe solo el servidor (account.deleteBar, service role) junto con billing_status suspended; un bar archivado conserva sus pedidos, pagos, turnos y asistencia por obligación fiscal y laboral (CFF art. 30, 5 años) pero ya no tiene usuarios ligados. Si se quita el candado, cualquier bar_admin del bar, que sí puede actualizar WineBar, borra o inventa su propia marca de baja y desincroniza lo que Mission Control ve como bar archivado. Un bar que aparece dado de baja por error no se arregla quitando este candado: lo revierte la plataforma.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "license_audit": {
      "type": "array",
      "items": { "type": "object" },
      "description": "Módulo 19: candado de ESCRITURA (rls.write solo role admin); no afecta a las lecturas. Bitácora de cambios manuales de licencia (quién, cuándo, valor anterior y nuevo, nota), máximo 100 entradas. La escribe solo settings.platformSetLicense (service role, solo plataforma). Si se quita el candado, un bar_admin del bar, que sí puede actualizar WineBar, borra o reescribe la evidencia de quién le cambió la licencia. Una bitácora que no aparece no se arregla quitando este candado.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "corte_emails": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Correos a los que se manda el corte de turno (D11)"
    },
    "payment_methods": {
      "type": "array",
      "description": "Formas de pago del bar (Entrega 2, §0/§5). Vacío = default Efectivo/Tarjeta/Transferencia. Se edita solo por la función settings",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "description": "Identificador estable (slug), p.ej. 'vales'" },
          "label": { "type": "string", "description": "Nombre visible, p.ej. 'Vales'" },
          "is_cash": { "type": "boolean", "description": "true si es efectivo (pide recibido y calcula cambio)" },
          "active": { "type": "boolean", "description": "Si se ofrece al cobrar" }
        }
      }
    },
    "prep_goal_kitchen_min": {
      "type": "number",
      "default": 15,
      "description": "Minutos meta para preparar un platillo de cocina"
    },
    "prep_goal_bar_min": {
      "type": "number",
      "default": 8,
      "description": "Minutos meta para preparar una bebida de barra"
    },
    "service_hours": {
      "type": "object",
      "description": "Ventana de horario de servicio del bar (para saber cuándo NO desplegar, §8 del plan)"
    }
  },
  "required": [
    "name"
  ],
  "name": "WineBar",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "bar_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
