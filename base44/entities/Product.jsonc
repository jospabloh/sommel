{
  // Menú del bar. Reemplaza el prototipo genérico (D6/D7 del plan técnico):
  // precio y costo en centavos, variantes (tamaños) con su propio precio y
  // costo, modificadores SIN costo (no afectan la utilidad reportada). El
  // costo nunca debe llegar al navegador de quien no tiene `Menú:ver_costos`
  // — eso lo hace la función `catalog` (listProducts redacta el costo), pero
  // RLS no puede distinguir `cost` de `variants[].cost` dentro de este mismo
  // objeto (un lock de campo no puede aislar un sub-campo de un array), así
  // que la única forma de que la redacción de `listProducts` sea real y no
  // solo una convención es que NADIE lea `Product` directo — auditoría
  // 2026-09-28: confirmado por grep que ningún código de `src/` lee
  // `Product` directo salvo `SuperAdmin.jsx` (plataforma). `read` queda
  // bloqueado a la plataforma; el servicio (`asServiceRole`, usado por
  // `catalog`) evalúa como `role: admin` y sigue leyendo sin problema.
  "name": "Product",
  "type": "object",
  "properties": {
    "tenant_id": { "type": "string", "description": "WineBar dueño de este producto" },
    "name": { "type": "string", "description": "Nombre del platillo o bebida" },
    "category_id": { "type": "string", "description": "ID de la Category a la que pertenece" },
    "station": {
      "type": "string",
      "enum": ["kitchen", "bar", "none"],
      "default": "none",
      "description": "A qué estación se envía al comandar (D9)"
    },
    "price": { "type": "integer", "description": "Precio de venta en centavos MXN" },
    "cost": { "type": "integer", "description": "Costo en centavos MXN. Nunca se manda al cliente sin Menú:ver_costos" },
    "variants": {
      "type": "array",
      "description": "Tamaños del mismo producto (p.ej. copa chica/mediana/grande). Con variantes, price/cost del producto se ignoran y cada renglón elige una (contrato §4)",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "description": "Identificador estable de la variante, p.ej. 'chico'" },
          "label": { "type": "string", "description": "Etiqueta visible, p.ej. 'Chico (2-4 personas)'" },
          "price": { "type": "integer", "description": "Precio de esta variante en centavos MXN" },
          "cost": { "type": ["integer", "null"], "description": "Costo de esta variante en centavos MXN. Puede ser null (aún no capturado)" }
        }
      }
    },
    "modifiers": {
      "type": "array",
      "description": "Extras/modificadores del producto: solo key/label, sin precio ni costo — no afectan la utilidad reportada (contrato §4, p.ej. 'En leche')",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "description": "Identificador estable del modificador, p.ej. 'leche'" },
          "label": { "type": "string", "description": "Etiqueta visible, p.ej. 'En leche (300 ml)'" }
        }
      }
    },
    "active": { "type": "boolean", "default": true, "description": "Visible en el menú de venta" },
    "seasonal": { "type": "boolean", "default": false, "description": "Producto de temporada" },
    "track_inventory": { "type": "boolean", "default": false, "description": "Si descuenta de un InventoryItem al venderse" },
    "stock_unit": {
      "type": "string",
      "enum": ["pieza", "botella", "g"],
      "description": "Unidad en la que se mide su inventario, si track_inventory es true"
    },
    "inventory_item_id": { "type": "string", "description": "InventoryItem del que descuenta, si track_inventory es true" }
  },
  "required": ["tenant_id", "name"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
