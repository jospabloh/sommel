{
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "WineBar this product belongs to"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "bottle",
        "glass"
      ],
      "default": "glass"
    },
    "category": {
      "type": "string",
      "description": "e.g. Tinto, Blanco, Espumoso, Aperitivo"
    },
    "price": {
      "type": "number",
      "description": "Selling price per unit"
    },
    "stock": {
      "type": "number",
      "default": 0,
      "description": "Units available"
    },
    "low_stock_threshold": {
      "type": "number",
      "default": 5,
      "description": "Alert when stock falls below this"
    }
  },
  "required": [
    "tenant_id",
    "name",
    "price"
  ],
  "name": "Product",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}