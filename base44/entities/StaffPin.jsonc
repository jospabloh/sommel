{
  // PIN del checador. Las cuatro operaciones son solo de plataforma: ni el
  // propio bar lee los hashes, únicamente el servidor (service role, que
  // evalúa como role:admin) los lee y escribe.
  "name": "StaffPin",
  "type": "object",
  "properties": {
    "tenant_id": { "type": "string", "description": "WineBar al que pertenece el PIN. Módulo 19, candado de LECTURA y ESCRITURA a nivel entidad: las cuatro operaciones son solo de plataforma (role admin). Ni el propio bar lee los hashes; solo el servidor (service role) los lee y escribe. Si se afloja la lectura, cualquier miembro del bar puede leer pin_hash y salt de sus compañeros y probar PINs sin el bloqueo por intentos; si se afloja la escritura, puede reiniciar failed_attempts o cambiar el PIN de otro. Un checador que no acepta el PIN no se arregla tocando este candado." },
    "user_id": { "type": "string", "description": "Usuario dueño del PIN; uno por usuario" },
    "pin_hash": { "type": "string", "description": "PBKDF2-SHA256, 100000 iteraciones, en hex" },
    "salt": { "type": "string", "description": "16 bytes aleatorios en hex, distinto por fila" },
    "failed_attempts": { "type": "integer", "default": 0, "description": "Intentos fallidos consecutivos" },
    "locked_until": { "type": ["string", "null"], "format": "date-time", "description": "Bloqueado hasta esta hora tras 5 fallos" }
  },
  "required": ["tenant_id", "user_id"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
