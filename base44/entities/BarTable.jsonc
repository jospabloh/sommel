{
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "WineBar this table belongs to"
    },
    "name": {
      "type": "string",
      "description": "Table label, e.g. Mesa 1, Barra 3"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "occupied"
      ],
      "default": "available"
    },
    "seats": {
      "type": "number",
      "default": 4
    }
  },
  "required": [
    "tenant_id",
    "name"
  ],
  "name": "BarTable",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}